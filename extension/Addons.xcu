<?xml version="1.0" encoding="UTF-8"?>
<oor:component-data xmlns:oor="http://openoffice.org/2001/registry"
                    xmlns:xs="http://www.w3.org/2001/XMLSchema"
                    oor:name="Addons" oor:package="org.openoffice.Office">
  <!--
    Script URL format, which LibreOffice does not document well and fails on with only a KeyError
    deep inside pythonscript.py:

        vnd.sun.star.script:<oxt file name>|<folder>|<file>.py$<function>?language=Python&location=user:uno_packages

    The first segment is the package name, and pythonscript.py derives that from the LAST element
    of the installed extension's URL — which is the .oxt's own file name, "NexusPLM.oxt". Omit it
    and the lookup raises KeyError; the toolbar still appears, and every button fails the moment it
    is pressed. Renaming the built package therefore breaks every command here.

    The command set is the Word add-in's (docs/COMMANDS.md there), minus Markup and Apply Markups,
    which are about Word's comments and tracked changes, and the Navigator pane. The menu carries all 23 commands flat, in the
    ribbon's six groups. The toolbar and the Tabbed UI carry the same commands stacked: four plain
    buttons (New, Open, Search, Properties) and six dropdowns (Account, Save, Tasks, Workflow,
    Values, NexusPLM) whose menus python/nexusplm_controllers.py supplies — the same split
    buttons the Word ribbon has.

    A script-provider toolbar cannot grey a button by document state. Every command therefore
    stays clickable and explains itself when it cannot run — "This document is not registered in
    PLM." Proper enablement needs a dispatch provider, which is a later piece.
  -->

  <!-- An entity is the wordiest way to say the same thing 24 times, but this is XML. -->
  <!--
    Every toolbar and notebookbar item carries Context, and it is not optional in practice: an
    add-on toolbar item without one is silently dropped, and a toolbar left with no items is never
    created at all — no entry under View > Toolbars, no error, nothing in the layout manager. Found
    by bisecting against a pristine profile after the toolbar vanished when the items were rewritten
    without it. Menu items do not need it.
  -->
  <node oor:name="AddonUI">

<!-- No Title here: the schema's ToolBarItems set has no toolbar-level properties, and a Title
         put on it made LibreOffice drop the whole toolbar without a word. An add-on toolbar is
         always listed as "Add-On N" under View > Toolbars; the Tabbed UI gets a proper home
         through OfficeNotebookBarMerging below. -->
    <node oor:name="OfficeToolBar">
      <node oor:name="com.nexusplm.openoffice.toolbar" oor:op="replace">
        <!-- Apache OpenOffice types a toolbar as a GROUP with a Title and a nested
             ToolBarItems set (share/registry/main.xcd, group "ToolBar"). LibreOffice treats
             OfficeToolBar as a set of items directly, with no wrapper, and rejects a Title
             outright. Written LibreOffice's way the toolbar is simply never created here:
             it does not appear under View > Toolbars at all and nothing is logged, while the
             menu from this same file works perfectly. Measured on Apache OpenOffice 4.1.16. -->
        <prop oor:name="Title" oor:type="xs:string">
          <value xml:lang="en-GB">Nexus PLM</value>
        </prop>
        <node oor:name="ToolBarItems">
            <node oor:name="t01" oor:op="replace">
              <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-GB">Account</value></prop>
              <prop oor:name="URL" oor:type="xs:string"><value>nexusplm:account</value></prop>
              <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
              <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument,com.sun.star.sheet.SpreadsheetDocument,com.sun.star.presentation.PresentationDocument,com.sun.star.drawing.DrawingDocument,com.sun.star.formula.FormulaProperties</value></prop>
            </node>
            <node oor:name="t02" oor:op="replace">
              <prop oor:name="URL" oor:type="xs:string"><value>private:separator</value></prop>
              <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument,com.sun.star.sheet.SpreadsheetDocument,com.sun.star.presentation.PresentationDocument,com.sun.star.drawing.DrawingDocument,com.sun.star.formula.FormulaProperties</value></prop>
            </node>
            <node oor:name="t03" oor:op="replace">
              <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-GB">New</value></prop>
              <prop oor:name="URL" oor:type="xs:string"><value>vnd.sun.star.script:NexusPLM.oxt|python|nexus_commands.py$new_from_template?language=Python&amp;location=user:uno_packages</value></prop>
              <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
              <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument,com.sun.star.sheet.SpreadsheetDocument,com.sun.star.presentation.PresentationDocument,com.sun.star.drawing.DrawingDocument,com.sun.star.formula.FormulaProperties</value></prop>
            </node>
            <node oor:name="t04" oor:op="replace">
              <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-GB">Open</value></prop>
              <prop oor:name="URL" oor:type="xs:string"><value>vnd.sun.star.script:NexusPLM.oxt|python|nexus_commands.py$open_from_plm?language=Python&amp;location=user:uno_packages</value></prop>
              <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
              <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument,com.sun.star.sheet.SpreadsheetDocument,com.sun.star.presentation.PresentationDocument,com.sun.star.drawing.DrawingDocument,com.sun.star.formula.FormulaProperties</value></prop>
            </node>
            <node oor:name="t05" oor:op="replace">
              <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-GB">Search</value></prop>
              <prop oor:name="URL" oor:type="xs:string"><value>vnd.sun.star.script:NexusPLM.oxt|python|nexus_commands.py$search?language=Python&amp;location=user:uno_packages</value></prop>
              <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
              <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument,com.sun.star.sheet.SpreadsheetDocument,com.sun.star.presentation.PresentationDocument,com.sun.star.drawing.DrawingDocument,com.sun.star.formula.FormulaProperties</value></prop>
            </node>
            <node oor:name="t06" oor:op="replace">
              <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-GB">Save</value></prop>
              <prop oor:name="URL" oor:type="xs:string"><value>nexusplm:save</value></prop>
              <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
              <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument,com.sun.star.sheet.SpreadsheetDocument,com.sun.star.presentation.PresentationDocument,com.sun.star.drawing.DrawingDocument,com.sun.star.formula.FormulaProperties</value></prop>
            </node>
            <node oor:name="t07" oor:op="replace">
              <prop oor:name="URL" oor:type="xs:string"><value>private:separator</value></prop>
              <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument,com.sun.star.sheet.SpreadsheetDocument,com.sun.star.presentation.PresentationDocument,com.sun.star.drawing.DrawingDocument,com.sun.star.formula.FormulaProperties</value></prop>
            </node>
            <node oor:name="t08" oor:op="replace">
              <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-GB">Tasks</value></prop>
              <prop oor:name="URL" oor:type="xs:string"><value>nexusplm:tasks</value></prop>
              <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
              <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument,com.sun.star.sheet.SpreadsheetDocument,com.sun.star.presentation.PresentationDocument,com.sun.star.drawing.DrawingDocument,com.sun.star.formula.FormulaProperties</value></prop>
            </node>
            <node oor:name="t09" oor:op="replace">
              <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-GB">Workflow</value></prop>
              <prop oor:name="URL" oor:type="xs:string"><value>nexusplm:workflow</value></prop>
              <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
              <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument,com.sun.star.sheet.SpreadsheetDocument,com.sun.star.presentation.PresentationDocument,com.sun.star.drawing.DrawingDocument,com.sun.star.formula.FormulaProperties</value></prop>
            </node>
            <node oor:name="t10" oor:op="replace">
              <prop oor:name="URL" oor:type="xs:string"><value>private:separator</value></prop>
              <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument,com.sun.star.sheet.SpreadsheetDocument,com.sun.star.presentation.PresentationDocument,com.sun.star.drawing.DrawingDocument,com.sun.star.formula.FormulaProperties</value></prop>
            </node>
            <node oor:name="t11" oor:op="replace">
              <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-GB">Properties</value></prop>
              <prop oor:name="URL" oor:type="xs:string"><value>vnd.sun.star.script:NexusPLM.oxt|python|nexus_commands.py$properties?language=Python&amp;location=user:uno_packages</value></prop>
              <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
              <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument,com.sun.star.sheet.SpreadsheetDocument,com.sun.star.presentation.PresentationDocument,com.sun.star.drawing.DrawingDocument,com.sun.star.formula.FormulaProperties</value></prop>
            </node>
            <node oor:name="t12" oor:op="replace">
              <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-GB">Values</value></prop>
              <prop oor:name="URL" oor:type="xs:string"><value>nexusplm:values</value></prop>
              <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
              <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument,com.sun.star.sheet.SpreadsheetDocument,com.sun.star.presentation.PresentationDocument,com.sun.star.drawing.DrawingDocument,com.sun.star.formula.FormulaProperties</value></prop>
            </node>
            <node oor:name="t13" oor:op="replace">
              <prop oor:name="URL" oor:type="xs:string"><value>private:separator</value></prop>
              <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument,com.sun.star.sheet.SpreadsheetDocument,com.sun.star.presentation.PresentationDocument,com.sun.star.drawing.DrawingDocument,com.sun.star.formula.FormulaProperties</value></prop>
            </node>
            <node oor:name="t14" oor:op="replace">
              <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-GB">NexusPLM</value></prop>
              <prop oor:name="URL" oor:type="xs:string"><value>nexusplm:about</value></prop>
              <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
              <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument,com.sun.star.sheet.SpreadsheetDocument,com.sun.star.presentation.PresentationDocument,com.sun.star.drawing.DrawingDocument,com.sun.star.formula.FormulaProperties</value></prop>
            </node>

      
        </node>
      </node>
    </node>

    <!--
      The Tabbed user interface (LibreOffice's ribbon). Its Writer definition,
      share/config/soffice.cfg/modules/swriter/ui/notebookbar.ui, carries an "Extension" tab whose
      content is a NotebookBarAddonsToolMergePoint with id "AddonCommand": the place LibreOffice
      itself set aside for add-ons' commands. The tab only appears once something merges into it.
      An extension cannot invent a tab of its own, but it does not need to — this is the one.
    -->
    <node oor:name="OfficeNotebookBarMerging">
      <node oor:name="com.nexusplm.openoffice" oor:op="replace">
        <node oor:name="S1" oor:op="replace">
          <prop oor:name="MergeNotebookBar" oor:type="xs:string"><value>notebookbar.ui</value></prop>
          <prop oor:name="MergePoint" oor:type="xs:string"><value>AddonCommand</value></prop>
          <prop oor:name="MergeCommand" oor:type="xs:string"><value>AddAfter</value></prop>
          <prop oor:name="MergeFallback" oor:type="xs:string"><value>AddLast</value></prop>
          <prop oor:name="MergeContext" oor:type="xs:string">
            <value>com.sun.star.text.TextDocument,com.sun.star.sheet.SpreadsheetDocument,com.sun.star.presentation.PresentationDocument,com.sun.star.drawing.DrawingDocument,com.sun.star.formula.FormulaProperties</value>
          </prop>
          <node oor:name="NotebookBarItems">
          <node oor:name="n01" oor:op="replace">
            <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-GB">Account</value></prop>
            <prop oor:name="URL" oor:type="xs:string"><value>nexusplm:account</value></prop>
            <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
            <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument,com.sun.star.sheet.SpreadsheetDocument,com.sun.star.presentation.PresentationDocument,com.sun.star.drawing.DrawingDocument,com.sun.star.formula.FormulaProperties</value></prop>
          </node>
          <node oor:name="n02" oor:op="replace">
            <prop oor:name="URL" oor:type="xs:string"><value>private:separator</value></prop>
            <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument,com.sun.star.sheet.SpreadsheetDocument,com.sun.star.presentation.PresentationDocument,com.sun.star.drawing.DrawingDocument,com.sun.star.formula.FormulaProperties</value></prop>
          </node>
          <node oor:name="n03" oor:op="replace">
            <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-GB">New</value></prop>
            <prop oor:name="URL" oor:type="xs:string"><value>vnd.sun.star.script:NexusPLM.oxt|python|nexus_commands.py$new_from_template?language=Python&amp;location=user:uno_packages</value></prop>
            <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
            <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument,com.sun.star.sheet.SpreadsheetDocument,com.sun.star.presentation.PresentationDocument,com.sun.star.drawing.DrawingDocument,com.sun.star.formula.FormulaProperties</value></prop>
          </node>
          <node oor:name="n04" oor:op="replace">
            <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-GB">Open</value></prop>
            <prop oor:name="URL" oor:type="xs:string"><value>vnd.sun.star.script:NexusPLM.oxt|python|nexus_commands.py$open_from_plm?language=Python&amp;location=user:uno_packages</value></prop>
            <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
            <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument,com.sun.star.sheet.SpreadsheetDocument,com.sun.star.presentation.PresentationDocument,com.sun.star.drawing.DrawingDocument,com.sun.star.formula.FormulaProperties</value></prop>
          </node>
          <node oor:name="n05" oor:op="replace">
            <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-GB">Search</value></prop>
            <prop oor:name="URL" oor:type="xs:string"><value>vnd.sun.star.script:NexusPLM.oxt|python|nexus_commands.py$search?language=Python&amp;location=user:uno_packages</value></prop>
            <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
            <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument,com.sun.star.sheet.SpreadsheetDocument,com.sun.star.presentation.PresentationDocument,com.sun.star.drawing.DrawingDocument,com.sun.star.formula.FormulaProperties</value></prop>
          </node>
          <node oor:name="n06" oor:op="replace">
            <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-GB">Save</value></prop>
            <prop oor:name="URL" oor:type="xs:string"><value>nexusplm:save</value></prop>
            <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
            <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument,com.sun.star.sheet.SpreadsheetDocument,com.sun.star.presentation.PresentationDocument,com.sun.star.drawing.DrawingDocument,com.sun.star.formula.FormulaProperties</value></prop>
          </node>
          <node oor:name="n07" oor:op="replace">
            <prop oor:name="URL" oor:type="xs:string"><value>private:separator</value></prop>
            <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument,com.sun.star.sheet.SpreadsheetDocument,com.sun.star.presentation.PresentationDocument,com.sun.star.drawing.DrawingDocument,com.sun.star.formula.FormulaProperties</value></prop>
          </node>
          <node oor:name="n08" oor:op="replace">
            <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-GB">Tasks</value></prop>
            <prop oor:name="URL" oor:type="xs:string"><value>nexusplm:tasks</value></prop>
            <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
            <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument,com.sun.star.sheet.SpreadsheetDocument,com.sun.star.presentation.PresentationDocument,com.sun.star.drawing.DrawingDocument,com.sun.star.formula.FormulaProperties</value></prop>
          </node>
          <node oor:name="n09" oor:op="replace">
            <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-GB">Workflow</value></prop>
            <prop oor:name="URL" oor:type="xs:string"><value>nexusplm:workflow</value></prop>
            <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
            <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument,com.sun.star.sheet.SpreadsheetDocument,com.sun.star.presentation.PresentationDocument,com.sun.star.drawing.DrawingDocument,com.sun.star.formula.FormulaProperties</value></prop>
          </node>
          <node oor:name="n10" oor:op="replace">
            <prop oor:name="URL" oor:type="xs:string"><value>private:separator</value></prop>
            <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument,com.sun.star.sheet.SpreadsheetDocument,com.sun.star.presentation.PresentationDocument,com.sun.star.drawing.DrawingDocument,com.sun.star.formula.FormulaProperties</value></prop>
          </node>
          <node oor:name="n11" oor:op="replace">
            <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-GB">Properties</value></prop>
            <prop oor:name="URL" oor:type="xs:string"><value>vnd.sun.star.script:NexusPLM.oxt|python|nexus_commands.py$properties?language=Python&amp;location=user:uno_packages</value></prop>
            <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
            <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument,com.sun.star.sheet.SpreadsheetDocument,com.sun.star.presentation.PresentationDocument,com.sun.star.drawing.DrawingDocument,com.sun.star.formula.FormulaProperties</value></prop>
          </node>
          <node oor:name="n12" oor:op="replace">
            <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-GB">Values</value></prop>
            <prop oor:name="URL" oor:type="xs:string"><value>nexusplm:values</value></prop>
            <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
            <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument,com.sun.star.sheet.SpreadsheetDocument,com.sun.star.presentation.PresentationDocument,com.sun.star.drawing.DrawingDocument,com.sun.star.formula.FormulaProperties</value></prop>
          </node>
          <node oor:name="n13" oor:op="replace">
            <prop oor:name="URL" oor:type="xs:string"><value>private:separator</value></prop>
            <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument,com.sun.star.sheet.SpreadsheetDocument,com.sun.star.presentation.PresentationDocument,com.sun.star.drawing.DrawingDocument,com.sun.star.formula.FormulaProperties</value></prop>
          </node>
          <node oor:name="n14" oor:op="replace">
            <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-GB">NexusPLM</value></prop>
            <prop oor:name="URL" oor:type="xs:string"><value>nexusplm:about</value></prop>
            <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
            <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument,com.sun.star.sheet.SpreadsheetDocument,com.sun.star.presentation.PresentationDocument,com.sun.star.drawing.DrawingDocument,com.sun.star.formula.FormulaProperties</value></prop>
          </node>
          </node>
        </node>
      </node>
    </node>

    <!--
      The icon for each command, by its URL, wherever the command appears — toolbar, menu or
      Tabbed UI. This is the only mechanism that draws them. ImageIdentifier on an item is the
      documented alternative, but a stem that LibreOffice cannot resolve does not fall through to
      this set — it wins, and the button is drawn as text. Measured by bisecting: the same package
      with every ImageIdentifier removed shows the icons. So no item carries one. The files are the
      Word add-in's own icons, resized to the 16px and 26px LibreOffice wants.
    -->
    <node oor:name="Images">
      <node oor:name="i01" oor:op="replace">
        <prop oor:name="URL" oor:type="xs:string"><value>vnd.sun.star.script:NexusPLM.oxt|python|nexus_commands.py$about?language=Python&amp;location=user:uno_packages</value></prop>
        <node oor:name="UserDefinedImages">
          <prop oor:name="ImageSmallURL" oor:type="xs:string"><value>%origin%/icons/Nexus_16.png</value></prop>
          <prop oor:name="ImageBigURL" oor:type="xs:string"><value>%origin%/icons/Nexus_26.png</value></prop>
        </node>
      </node>
      <node oor:name="i02" oor:op="replace">
        <prop oor:name="URL" oor:type="xs:string"><value>vnd.sun.star.script:NexusPLM.oxt|python|nexus_commands.py$change_owner?language=Python&amp;location=user:uno_packages</value></prop>
        <node oor:name="UserDefinedImages">
          <prop oor:name="ImageSmallURL" oor:type="xs:string"><value>%origin%/icons/ChangeOwner_16.png</value></prop>
          <prop oor:name="ImageBigURL" oor:type="xs:string"><value>%origin%/icons/ChangeOwner_26.png</value></prop>
        </node>
      </node>
      <node oor:name="i03" oor:op="replace">
        <prop oor:name="URL" oor:type="xs:string"><value>vnd.sun.star.script:NexusPLM.oxt|python|nexus_commands.py$check_in?language=Python&amp;location=user:uno_packages</value></prop>
        <node oor:name="UserDefinedImages">
          <prop oor:name="ImageSmallURL" oor:type="xs:string"><value>%origin%/icons/CheckIn_16.png</value></prop>
          <prop oor:name="ImageBigURL" oor:type="xs:string"><value>%origin%/icons/CheckIn_26.png</value></prop>
        </node>
      </node>
      <node oor:name="i04" oor:op="replace">
        <prop oor:name="URL" oor:type="xs:string"><value>vnd.sun.star.script:NexusPLM.oxt|python|nexus_commands.py$check_out?language=Python&amp;location=user:uno_packages</value></prop>
        <node oor:name="UserDefinedImages">
          <prop oor:name="ImageSmallURL" oor:type="xs:string"><value>%origin%/icons/CheckOut_16.png</value></prop>
          <prop oor:name="ImageBigURL" oor:type="xs:string"><value>%origin%/icons/CheckOut_26.png</value></prop>
        </node>
